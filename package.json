{
  "name": "subway-ai-guide-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:train-lost && npm run test:station-master && npm run test:station-entry && npm run test:station-route && npm run test:lost-found && npm run test:arrivals && next build",
    "start": "next start",
    "test:chat-context": "node --experimental-vm-modules --test tests/chat-history.test.mjs tests/chat-provider.test.mjs",
    "test:arrivals": "node --experimental-vm-modules --test tests/train-arrivals.test.mjs tests/train-arrival-api.test.mjs",
    "test:lost-found": "node --experimental-vm-modules --test tests/lost-found-search.test.mjs",
    "test:lost-found-ui": "node --experimental-vm-modules tests/lost-found-ui.cjs",
    "test:feedback": "node --experimental-vm-modules --test tests/feedback.test.mjs",
    "test:feedback-flow": "node tests/feedback-flow.cjs",
    "test:train-lost": "node --experimental-vm-modules --test tests/train-lost.test.mjs",
    "test:tour": "node --experimental-vm-modules --test tests/tour-language-api.test.mjs tests/station-coordinates.test.mjs",
    "test:tour-ui": "node --experimental-vm-modules tests/tour-station-ui.cjs",
    "test:stats": "node --experimental-vm-modules --test tests/stats-delivery.test.mjs tests/stats-event-api.test.mjs",
    "test:stats-ui": "node tests/stats-recovery-ui.cjs",
    "generate:station-master": "node scripts/build-station-master.mjs",
    "test:station-master": "node --experimental-vm-modules --test tests/station-master.test.mjs",
    "test:station-master-ui": "node tests/station-master-ui.cjs",
    "test:station-entry": "node --experimental-vm-modules --test tests/station-entry.test.mjs",
    "test:station-entry-ui": "node tests/station-entry-ui.cjs",
    "test:station-route": "node --experimental-vm-modules --test tests/station-route.test.mjs",
    "test:station-route-ui": "node --experimental-vm-modules tests/station-route-ui.cjs",
    "test:arrivals-ui": "node --experimental-vm-modules tests/multi-arrivals-ui.cjs"
  },
  "dependencies": {
    "next": "16.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@vercel/oidc": "^4.0.0",
    "google-auth-library": "^11.1.0",
    "@vercel/analytics": "^1.5.0"
  }
}
